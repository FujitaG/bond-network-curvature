import Mathlib.Probability.Independence.ZeroOne
import GraphStability.Lifetime
import GraphStability.BlockDecomposition

/-!
# Survival over intervals of `T` rounds (Lemma T2.5)

Fix an edge `e`, an interval length `T ≥ 1`, and positive `σ` and `θ`. Whatever
the noise of rounds `1, …, n` was, the fresh noise of the next `T` rounds
brings the difference across `e` to the threshold at round `n + T` with
probability at least `p_T(e)` (`break_probability_of_past_event`). Applying
this bound to survival past round `n` at `n = 0, T, 2T, …` gives Lemma T2.5.
-/

open MeasureTheory ProbabilityTheory
open scoped ENNReal

namespace GraphStability

variable {V : Type*} [Fintype V]
variable {G : SimpleGraph V} {P : MarkovKernel V} {σ : ℝ} {Ω : Type*}
  [MeasureSpace Ω] [IsProbabilityMeasure (volume : Measure Ω)]

/-- The σ-algebra generated by the noise of the rounds `1, …, n`. -/
def pastNoiseSigma (proc : GaussianAveragingProcess P σ Ω) (n : ℕ) :
    MeasurableSpace Ω :=
  ⨆ q ∈ {q : ℕ × V | q.1 < n},
    MeasurableSpace.comap (proc.noise q.1 q.2) inferInstance

/-- The σ-algebra generated by the noise of the rounds after `n`. -/
def futureNoiseSigma (proc : GaussianAveragingProcess P σ Ω) (n : ℕ) :
    MeasurableSpace Ω :=
  ⨆ q ∈ {q : ℕ × V | q.1 < n}ᶜ,
    MeasurableSpace.comap (proc.noise q.1 q.2) inferInstance

/-- The noise of rounds `1, …, n` and the noise of the later rounds generate
independent σ-algebras. -/
theorem indep_pastNoiseSigma_futureNoiseSigma (proc : GaussianAveragingProcess P σ Ω)
    (n : ℕ) :
    Indep (pastNoiseSigma proc n) (futureNoiseSigma proc n) volume :=
  indep_biSup_compl
    (s := fun q : ℕ × V =>
      MeasurableSpace.comap (proc.noise q.1 q.2) inferInstance)
    (fun q => (proc.noise_measurable q.1 q.2).comap_le) proc.noise_indep.iIndep
    {q : ℕ × V | q.1 < n}

/-- The noise of a round `1 ≤ t ≤ n` is measurable with respect to the past. -/
theorem measurable_ξ_pastNoiseSigma (proc : GaussianAveragingProcess P σ Ω)
    {n t : ℕ} (x : V) (ht1 : 1 ≤ t) (ht : t ≤ n) :
    Measurable[pastNoiseSigma proc n] (proc.ξ t x) := by
  rw [measurable_iff_comap_le]
  exact le_biSup (fun q : ℕ × V =>
    MeasurableSpace.comap (proc.noise q.1 q.2) inferInstance)
    (show (t - 1, x) ∈ {q : ℕ × V | q.1 < n} by
      simp only [Set.mem_setOf_eq]; omega)

/-- The noise of a round `t > n` is measurable with respect to the future. -/
theorem measurable_ξ_futureNoiseSigma (proc : GaussianAveragingProcess P σ Ω)
    {n t : ℕ} (x : V) (ht : n < t) :
    Measurable[futureNoiseSigma proc n] (proc.ξ t x) := by
  rw [measurable_iff_comap_le]
  exact le_biSup (fun q : ℕ × V =>
    MeasurableSpace.comap (proc.noise q.1 q.2) inferInstance)
    (show (t - 1, x) ∈ {q : ℕ × V | q.1 < n}ᶜ by
      simp only [Set.mem_compl_iff, Set.mem_setOf_eq]; omega)

/-- Every set measurable with respect to `pastNoiseSigma proc n` is measurable
on `Ω`. -/
theorem pastNoiseSigma_le (proc : GaussianAveragingProcess P σ Ω) (n : ℕ) :
    pastNoiseSigma proc n ≤ (inferInstance : MeasurableSpace Ω) :=
  iSup₂_le fun q _ => (proc.noise_measurable q.1 q.2).comap_le

/-- Every set measurable with respect to `futureNoiseSigma proc n` is
measurable on `Ω`. -/
theorem futureNoiseSigma_le (proc : GaussianAveragingProcess P σ Ω) (n : ℕ) :
    futureNoiseSigma proc n ≤ (inferInstance : MeasurableSpace Ω) :=
  iSup₂_le fun q _ => (proc.noise_measurable q.1 q.2).comap_le

variable [DecidableEq V]

/-- The values up to round `n` are measurable with respect to the noise of
rounds `1, …, n`. -/
theorem measurable_f_pastNoiseSigma (proc : GaussianAveragingProcess P σ Ω)
    {t n : ℕ} (ht : t ≤ n) (x : V) :
    Measurable[pastNoiseSigma proc n] (proc.f t x) := by
  rw [funext (f_eq_sum_rounds proc t x)]
  refine Finset.measurable_sum _ fun s hs =>
    Finset.measurable_sum _ fun z _ => ?_
  obtain ⟨hs1, hst⟩ := Finset.mem_Icc.mp hs
  exact (measurable_ξ_pastNoiseSigma proc z hs1 (hst.trans ht)).const_mul _

/-- The past part depends only on the noise of the rounds `1, …, n`. -/
theorem measurable_pastPart (proc : GaussianAveragingProcess P σ Ω)
    (u v : V) (n T : ℕ) :
    Measurable[pastNoiseSigma proc n] (pastPart proc u v n T) := by
  unfold pastPart
  refine Finset.measurable_sum _ fun s hs =>
    Finset.measurable_sum _ fun z _ => ?_
  obtain ⟨hs1, hsn⟩ := Finset.mem_Icc.mp hs
  exact (measurable_ξ_pastNoiseSigma proc z hs1 hsn).const_mul _

/-- The fresh part depends only on the noise of the rounds after `n`. -/
theorem measurable_freshPart (proc : GaussianAveragingProcess P σ Ω)
    (u v : V) (n T : ℕ) :
    Measurable[futureNoiseSigma proc n] (freshPart proc u v n T) := by
  unfold freshPart
  refine Finset.measurable_sum _ fun s hs =>
    Finset.measurable_sum _ fun z _ => ?_
  exact (measurable_ξ_futureNoiseSigma proc z (Finset.mem_Icc.mp hs).1).const_mul _

/-- For every event `A` determined by the noise of rounds `1, …, n`,
`ℙ(A ∩ {|D_{n+T}(e)| ≥ θ}) ≥ p_T(e) ℙ(A)`. -/
theorem break_probability_of_past_event (proc : GaussianAveragingProcess P σ Ω) (hσ : 0 < σ)
    {θ : ℝ} (hθ : 0 < θ) {u v : V} {T : ℕ}
    (hV : 0 < normalizedVariance P u v T) (n : ℕ)
    {A : Set Ω} (hA : MeasurableSet[pastNoiseSigma proc n] A) :
    ENNReal.ofReal (blockProbability (normalizedVariance P u v T) (θ / σ)) * volume A
      ≤ volume (A ∩ {ω | θ ≤ |proc.f (n + T) u ω - proc.f (n + T) v ω|}) := by
  set p : ℝ≥0∞ := ENNReal.ofReal (blockProbability (normalizedVariance P u v T) (θ / σ))
  set c := pastPart proc u v n T
  set g := freshPart proc u v n T
  have hfactor := (Indep_iff _ _ _).mp (indep_pastNoiseSigma_futureNoiseSigma proc n)
  -- The two pieces of `A` and the two half-lines of the fresh part.
  have hC1 : MeasurableSet[pastNoiseSigma proc n] {ω | 0 ≤ c ω} :=
    measurable_pastPart proc u v n T measurableSet_Ici
  have hC2 : MeasurableSet[pastNoiseSigma proc n] {ω | c ω < 0} :=
    measurable_pastPart proc u v n T measurableSet_Iio
  have hG1 : MeasurableSet[futureNoiseSigma proc n] {ω | θ ≤ g ω} :=
    measurable_freshPart proc u v n T measurableSet_Ici
  have hG2 : MeasurableSet[futureNoiseSigma proc n] {ω | g ω ≤ -θ} :=
    measurable_freshPart proc u v n T measurableSet_Iic
  have hge1 : p ≤ volume {ω | θ ≤ g ω} := freshPart_ge_probability proc hσ n hV hθ
  have hge2 : p ≤ volume {ω | g ω ≤ -θ} := freshPart_le_neg_probability proc hσ n hV hθ
  have hfac1 := hfactor _ _ (hA.inter hC1) hG1
  have hfac2 := hfactor _ _ (hA.inter hC2) hG2
  -- `A` is the disjoint union of its two pieces.
  have hsplit : volume A = volume (A ∩ {ω | 0 ≤ c ω}) + volume (A ∩ {ω | c ω < 0}) := by
    rw [← measure_inter_add_diff A (pastNoiseSigma_le proc n _ hC1)]
    simp only [Set.diff_eq, Set.compl_setOf, not_le]
  -- On each piece the matching half-line forces the break.
  have hcorner :
      (A ∩ {ω | 0 ≤ c ω}) ∩ {ω | θ ≤ g ω} ∪
          (A ∩ {ω | c ω < 0}) ∩ {ω | g ω ≤ -θ} ⊆
        A ∩ {ω | θ ≤ |proc.f (n + T) u ω - proc.f (n + T) v ω|} := by
    simpa only [Set.inter_union_distrib_left, ← Set.inter_assoc,
      edgeDiff_eq_past_add_fresh proc u v n T] using
      Set.inter_subset_inter_right A (signSplit_subset c g θ)
  have hdisj : Disjoint ((A ∩ {ω | 0 ≤ c ω}) ∩ {ω | θ ≤ g ω})
      ((A ∩ {ω | c ω < 0}) ∩ {ω | g ω ≤ -θ}) := by
    rw [Set.disjoint_left]
    rintro ω ⟨⟨-, h1⟩, -⟩ ⟨⟨-, h2⟩, -⟩
    exact (not_lt_of_ge (show 0 ≤ c ω from h1)) h2
  have hmeas : MeasurableSet ((A ∩ {ω | c ω < 0}) ∩ {ω | g ω ≤ -θ}) :=
    (pastNoiseSigma_le proc n _ (hA.inter hC2)).inter (futureNoiseSigma_le proc n _ hG2)
  calc p * volume A
      = volume (A ∩ {ω | 0 ≤ c ω}) * p + volume (A ∩ {ω | c ω < 0}) * p := by
        rw [hsplit]; ring
    _ ≤ volume (A ∩ {ω | 0 ≤ c ω}) * volume {ω | θ ≤ g ω}
          + volume (A ∩ {ω | c ω < 0}) * volume {ω | g ω ≤ -θ} :=
        add_le_add (mul_le_mul_left' hge1 _) (mul_le_mul_left' hge2 _)
    _ = volume ((A ∩ {ω | 0 ≤ c ω}) ∩ {ω | θ ≤ g ω}
          ∪ (A ∩ {ω | c ω < 0}) ∩ {ω | g ω ≤ -θ}) := by
        rw [measure_union hdisj hmeas, hfac1, hfac2]
    _ ≤ _ := measure_mono hcorner

/-- Survival past round `n + T` has probability at most `(1 - p_T(e))` times
the probability of survival past round `n`. -/
theorem lifetime_gt_add_le (proc : GaussianAveragingProcess P σ Ω) (hσ : 0 < σ)
    {θ : ℝ} (hθ : 0 < θ)
    {u v : V} (hadj : G.Adj u v) {T : ℕ} (hT : 1 ≤ T) (n : ℕ) :
    volume {ω | ((n + T : ℕ) : ℕ∞) < lifetime G θ proc ω}
      ≤ (1 - ENNReal.ofReal (blockProbability (normalizedVariance P u v T) (θ / σ)))
          * volume {ω | (n : ℕ∞) < lifetime G θ proc ω} := by
  have hV : 0 < normalizedVariance P u v T := normalizedVariance_pos P hadj.ne hT
  set p : ℝ≥0∞ :=
    ENNReal.ofReal (blockProbability (normalizedVariance P u v T) (θ / σ))
  let A : Set Ω := {ω | (n : ℕ∞) < lifetime G θ proc ω}
  let B : Set Ω := {ω | θ ≤ |proc.f (n + T) u ω - proc.f (n + T) v ω|}
  have hBm : MeasurableSet B :=
    measurableSet_le measurable_const
      ((measurable_f proc (n + T) u).sub (measurable_f proc (n + T) v)).abs
  have hkey : p * volume A ≤ volume (A ∩ B) :=
    break_probability_of_past_event proc hσ hθ hV n
      (measurableSet_lifetime_gt_of_measurable proc θ n fun _ hn x =>
        measurable_f_pastNoiseSigma proc hn x)
  -- Survival past round `n + T` implies survival past round `n` and a difference
  -- across the chosen edge below the threshold at round `n + T`.
  have hsub : {ω | ((n + T : ℕ) : ℕ∞) < lifetime G θ proc ω} ⊆ A \ B := by
    intro ω hω
    change ((n + T : ℕ) : ℕ∞) < lifetime G θ proc ω at hω
    refine ⟨lt_of_le_of_lt (Nat.cast_le.mpr (Nat.le_add_right n T)) hω, ?_⟩
    intro hBω
    exact (not_le_of_gt hω) ((lifetime_le_iff (G := G) proc θ (n + T) ω).2
      ⟨n + T, le_rfl, u, v, hadj, hBω⟩)
  refine (measure_mono hsub).trans ?_
  calc
    volume (A \ B) = volume A - volume (A ∩ B) :=
      ENNReal.eq_sub_of_add_eq (measure_ne_top _ _) (measure_diff_add_inter A hBm)
    _ ≤ volume A - p * volume A := tsub_le_tsub_left hkey _
    _ = (1 - p) * volume A := by
      rw [ENNReal.sub_mul (fun _ _ => measure_ne_top _ _), one_mul]

/-- Lemma T2.5 (survival bound): `ℙ(τ_θ > k T) ≤ (1 - p_T(e))^k` for every
`k : ℕ`. -/
theorem lifetime_gt_mul_le_pow (proc : GaussianAveragingProcess P σ Ω) (hσ : 0 < σ)
    {θ : ℝ} (hθ : 0 < θ)
    {u v : V} (hadj : G.Adj u v) {T : ℕ} (hT : 1 ≤ T) (k : ℕ) :
    volume {ω | ((k * T : ℕ) : ℕ∞) < lifetime G θ proc ω}
      ≤ (1 - ENNReal.ofReal
          (blockProbability (normalizedVariance P u v T) (θ / σ))) ^ k := by
  induction k with
  | zero => simpa using prob_le_one
  | succ k ih =>
      rw [Nat.succ_mul, pow_succ']
      exact (lifetime_gt_add_le proc hσ hθ hadj hT (k * T)).trans (mul_le_mul_left' ih _)

/-- Lemma T2.5 (mean-lifetime bound): `𝔼[τ_θ] ≤ T / p_T(e)`. -/
theorem meanLifetime_upper_bound (proc : GaussianAveragingProcess P σ Ω) (hσ : 0 < σ)
    {θ : ℝ} (hθ : 0 < θ)
    {u v : V} (hadj : G.Adj u v) {T : ℕ} (hT : 1 ≤ T) :
    meanLifetime G θ proc
      ≤ (T : ℝ≥0∞)
        * (ENNReal.ofReal
            (blockProbability (normalizedVariance P u v T) (θ / σ)))⁻¹ := by
  haveI : NeZero T := ⟨Nat.ne_of_gt hT⟩
  have hV : 0 < normalizedVariance P u v T := normalizedVariance_pos P hadj.ne hT
  set p : ℝ≥0∞ :=
    ENNReal.ofReal (blockProbability (normalizedVariance P u v T) (θ / σ))
  have hp1 : p ≤ 1 := (freshPart_ge_probability proc hσ 0 hV hθ).trans prob_le_one
  have htail : ∀ t : ℕ,
      volume {ω | (t : ℕ∞) < lifetime G θ proc ω}
        ≤ (1 - p) ^ (t / T) := by
    intro t
    refine (measure_mono ?_).trans (lifetime_gt_mul_le_pow proc hσ hθ hadj hT (t / T))
    intro ω hω
    exact lt_of_le_of_lt (Nat.cast_le.mpr (Nat.div_mul_le_self t T))
      (show (t : ℕ∞) < lifetime G θ proc ω from hω)
  calc meanLifetime G θ proc ≤ ∑' t : ℕ, (1 - p) ^ (t / T) := ENNReal.tsum_le_tsum htail
    _ = ∑' q : ℕ × Fin T, (1 - p) ^ q.1 :=
        (Nat.divModEquiv T).tsum_eq (fun q : ℕ × Fin T => (1 - p) ^ q.1)
    _ = ∑' k : ℕ, ∑' s : Fin T, (1 - p) ^ k :=
        ENNReal.tsum_prod (f := fun k (_ : Fin T) => (1 - p) ^ k)
    _ = ∑' k : ℕ, (T : ℝ≥0∞) * (1 - p) ^ k :=
        tsum_congr fun k => by simp [tsum_fintype, nsmul_eq_mul]
    _ = (T : ℝ≥0∞) * ∑' k : ℕ, (1 - p) ^ k := ENNReal.tsum_mul_left
    _ = (T : ℝ≥0∞) * p⁻¹ := by
        rw [ENNReal.tsum_geometric, ENNReal.sub_sub_cancel ENNReal.one_ne_top hp1]

end GraphStability
